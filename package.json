{
	"name": "local-cli-workers",
	"displayName": "Local CLI Workers",
	"description": "Route VS Code tasks to the locally installed Codex and Claude Code CLIs, each signed in with its own subscription.",
	"version": "0.1.0",
	"publisher": "local-cli-workers",
	"license": "MIT",
	"repository": "https://github.com/thispc/vscode-openai-plugin",
	"engines": {
		"vscode": "^1.88.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "localCliWorkers.chat",
				"title": "Local CLI Workers: Chat"
			},
			{
				"command": "localCliWorkers.newChat",
				"title": "Local CLI Workers: New Conversation"
			},
			{
				"command": "localCliWorkers.chatInput",
				"title": "Local CLI Workers: Chat (input box)"
			},
			{
				"command": "localCliWorkers.showQuota",
				"title": "Local CLI Workers: Show Claude Usage and Gear"
			},
			{
				"command": "localCliWorkers.runTask",
				"title": "Local CLI Workers: Run Task"
			},
			{
				"command": "localCliWorkers.cancelTask",
				"title": "Local CLI Workers: Cancel Active Task"
			},
			{
				"command": "localCliWorkers.showWorkers",
				"title": "Local CLI Workers: Show Worker Status"
			},
			{
				"command": "localCliWorkers.checkAuth",
				"title": "Local CLI Workers: Check CLI Authentication"
			},
			{
				"command": "localCliWorkers.openWorkerTerminal",
				"title": "Local CLI Workers: Open Worker Terminal"
			},
			{
				"command": "localCliWorkers.resumeTask",
				"title": "Local CLI Workers: Resume Task"
			},
			{
				"command": "localCliWorkers.clearHistory",
				"title": "Local CLI Workers: Clear Task History"
			}
		],
		"views": {
			"localCliWorkers": [
				{
					"id": "localCliWorkers.tasks",
					"name": "Agent Tasks",
					"when": "workspaceFolderCount > 0",
					"icon": "$(hubot)"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "localCliWorkers.runTask",
					"when": "view == localCliWorkers.tasks",
					"group": "navigation"
				},
				{
					"command": "localCliWorkers.clearHistory",
					"when": "view == localCliWorkers.tasks",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "localCliWorkers.cancelTask",
					"when": "view == localCliWorkers.tasks && viewItem == runningTask",
					"group": "inline"
				},
				{
					"command": "localCliWorkers.resumeTask",
					"when": "view == localCliWorkers.tasks && viewItem == task",
					"group": "inline"
				}
			]
		},
		"configuration": {
			"title": "Local CLI Workers",
			"properties": {
				"localCliWorkers.managerModel": {
					"type": "string",
					"default": "local manager",
					"description": "Label for the manager responsible for routing and reviewing worker tasks."
				},
				"localCliWorkers.defaultWorker": {
					"type": "string",
					"enum": [
						"auto",
						"codex",
						"claude"
					],
					"default": "auto"
				},
				"localCliWorkers.codexCommand": {
					"type": "string",
					"default": "codex"
				},
				"localCliWorkers.codexModel": {
					"type": "string",
					"default": "local Codex CLI"
				},
				"localCliWorkers.claudeCommand": {
					"type": "string",
					"default": "claude"
				},
				"localCliWorkers.claudeModel": {
					"type": "string",
					"default": "local Claude Code CLI"
				},
				"localCliWorkers.maxConcurrentTasks": {
					"type": "number",
					"default": 1,
					"minimum": 1,
					"maximum": 8
				},
				"localCliWorkers.taskTimeoutMs": {
					"type": "number",
					"default": 600000,
					"minimum": 1000
				},
				"localCliWorkers.showWorkerTerminals": {
					"type": "boolean",
					"default": true
				},
				"localCliWorkers.failureThreshold": {
					"type": "number",
					"default": 3,
					"minimum": 1,
					"maximum": 20
				},
				"localCliWorkers.usageThreshold": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 10000,
					"description": "Optional hard cap on completed tasks per worker per session. 0 means off; real limits come from what each CLI reports."
				},
				"localCliWorkers.codexSandbox": {
					"type": "string",
					"enum": [
						"read-only",
						"workspace-write",
						"danger-full-access"
					],
					"default": "read-only",
					"description": "Sandbox codex exec runs under. read-only suits reviews; workspace-write lets it edit files."
				},
				"localCliWorkers.limitedCooldownMs": {
					"type": "number",
					"default": 1800000,
					"minimum": 60000,
					"description": "How long to rest a worker whose CLI reported a usage limit without naming a reset time."
				},
				"localCliWorkers.claudeModelId": {
					"type": "string",
					"default": "sonnet",
					"description": "Model passed to claude --model. Leave empty for the CLI default, which on a Pro plan can answer 'requires usage credits'."
				},
				"localCliWorkers.codexModelId": {
					"type": "string",
					"default": "",
					"description": "Model passed to codex -m. Empty uses the Codex default for your ChatGPT plan."
				},
				"localCliWorkers.powerSaver.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Pick the worker and model from how much of Claude's window is left, read from ~/.claude/usage-cache.json."
				},
				"localCliWorkers.powerSaver.saverBelowPercent": {
					"type": "number",
					"default": 30,
					"minimum": 0,
					"maximum": 100,
					"description": "With this much or less left, send the work to codex and save the rest of Claude's window."
				},
				"localCliWorkers.powerSaver.ladder": {
					"type": "array",
					"default": [
						{
							"atLeast": 70,
							"model": "fable"
						},
						{
							"atLeast": 50,
							"model": "opus"
						},
						{
							"atLeast": 30,
							"model": "sonnet"
						}
					],
					"description": "Which Claude model to use at how much of the window left, richest first. The first rung whose atLeast is met wins.",
					"items": {
						"type": "object",
						"required": [
							"atLeast",
							"model"
						],
						"properties": {
							"atLeast": {
								"type": "number",
								"minimum": 0,
								"maximum": 100,
								"description": "Percent of the window still left."
							},
							"model": {
								"type": "string",
								"description": "Model to pass to claude --model, e.g. fable, opus, sonnet, haiku."
							}
						}
					}
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p tsconfig.json",
		"watch": "tsc -w -p tsconfig.json",
		"test": "npm run compile && node --test dist/test/**/*.test.js",
		"package": "npm run compile && vsce package --no-dependencies"
	},
	"devDependencies": {
		"@types/node": "^20.11.30",
		"@types/vscode": "^1.88.0",
		"typescript": "^5.4.5"
	},
	"dependencies": {}
}
